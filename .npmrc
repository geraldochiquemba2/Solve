auto-install-peers=false
strict-peer-dependencies=false
package-manager-strict=false
ignore-scripts=false
# SECURITY: espera 7 dias antes de resolver versões recém-publicadas, que
# podem ser maliciosas ou instáveis. Afeta apenas o npm (o pnpm lê
# minimumReleaseAge em pnpm-workspace.yaml).
min-release-age=7
