# Solve Corporate CRM — mapa de variáveis (SEM valores reais)
# Copiar para .env:  cp .env.example .env
# NUNCA commitar .env* com valores. Segredos vivem no dashboard Render (sync: false).

DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# BD nova do Cademi CRM (fase 2 BDs; DATABASE_URL mantém a do ginásio)
CRM_DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# TLS do Postgres: por omissão o certificado do servidor é verificado
# (rejeitar =false deixa a ligação aberta a MITM). Só poner =false em BD
# local com certificado self-signed. NÃO definir em produção.
DB_SSL_REJECT_UNAUTHORIZED=
JWT_SECRET=
API_KEY=
NODE_ENV=production
PORT=3000

FRONTEND_URL=https://solve-sqoh.onrender.com
CORS_ORIGIN=https://solve-sqoh.onrender.com
VITE_API_URL=https://solve-sqoh.onrender.com

OVG_API_URL=https://samorafitstudio.onvirtualgym.com
OVG_USERNAME=
OVG_PASSWORD=
OVG_CLUB_CODE=LUA

EKWANZA_CLIENT_ID=
EKWANZA_CLIENT_SECRET=
EKWANZA_RESOURCE=
EKWANZA_GPO_URL=
EKWANZA_ACCOUNT=06100363
EKWANZA_GPO_API_KEY=
EKWANZA_GPR_API_KEY=
EKWANZA_GPO_PAYMENT_METHOD=
EKWANZA_REF_PAYMENT_METHOD=

# WiPay (gateway novo; fluxo hospedado). Sem isto, mcx_express cai no GPO É-kwanza.
WIPAY_CLIENT_ID=
WIPAY_CLIENT_SECRET=

# Supabase (varrimento Fit90: landing -> CRM de 5 em 5 min). Sem isto, desligado.
SUPABASE_URL=https://fslrkrhuatzfqxbzilnd.supabase.co
SUPABASE_SERVICE_KEY=

CADEMI_API_URL=
CADEMI_API_KEY=

WHATSAPP_API_KEY=

# --- Integrações da landing (apps/web) ---
# ATENÇÃO: variáveis VITE_* são embutidas no bundle do browser — servem para
# URL/ID públicos. Credenciais reais (API keys) pertencem ao backend
# (apps/api), nunca a um VITE_*.
VITE_PAY4ALL_API_URL=
VITE_PAY4ALL_API_KEY=
VITE_VIRTUAGYM_API_URL=
VITE_VIRTUAGYM_API_KEY=
VITE_VIRTUAGYM_CLUB_ID=

# --- Cota Neon mensal (fase Cademi-CRM, sem ginasio) ---
# Intervalos em ms. Defaults: 15min. Aumentar = menos transferencia.
EXPIRY_INTERVAL_MS=900000
AUTOSYNC_INTERVAL_MS=900000
# Modulo ginasio (OVG): manter desligado ate o ginasio entrar
# ENABLE_OVG_SYNC=true
